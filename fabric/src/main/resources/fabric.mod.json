{
  "schemaVersion": 1,
  "id": "blockpops",
  "version": "${version}",
  "name": "BlockPops",
  "description": "BlockPops - A Minecraft mod featuring collectible figures, animated blocks and interactive claw machine gameplay.",
  "authors": [
    "ThePlumTeam"
  ],
  "contact": {
    "homepage": "https://github.com/ThePlumTeam/BlockPops",
    "sources": "https://github.com/ThePlumTeam/BlockPops"
  },
  "license": "All Rights Reserved",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.theplumteam.fabric.BlockPopsFabric"
    ],
    "client": [
      "com.theplumteam.fabric.BlockPopsFabricClient"
    ]
  },
  "mixins": [
    "blockpops.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "architectury": ">=${architectury_version}",
    "geckolib": ">=${geckolib_version}"
  }
}

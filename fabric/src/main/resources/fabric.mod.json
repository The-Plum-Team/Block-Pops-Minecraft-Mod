{
  "schemaVersion": 1,
  "id": "blockpops",
  "version": "${version}",
  "name": "BlockPops",
  "description": "BlockPops - A Minecraft mod featuring collectible figures, animated blocks and interactive claw machine gameplay.",
  "authors": [
    "ThePlumTeam"
  ],
  "contact": {
    "homepage": "https://github.com/The-Plum-Team/Block-Pops-Minecraft-Mod",
    "sources": "https://github.com/The-Plum-Team/Block-Pops-Minecraft-Mod"
  },
  "license": "All Rights Reserved",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.theplumteam.fabric.BlockPopsFabric"
    ],
    "client": [
      "com.theplumteam.fabric.BlockPopsFabricClient"
    ]
  },
  "mixins": [
    "blockpops.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_requirement}",
    "fabric-api": "*",
    "minecraft": "${minecraft_requirement}",
    "architectury": "${architectury_requirement}",
    "geckolib": "${geckolib_requirement}"
  }
}

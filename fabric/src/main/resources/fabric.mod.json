{
  "schemaVersion": 1,
  "id": "blockpops",
  "version": "${version}",
  "name": "BlockPops",
  "description": "BlockPops - A Minecraft mod featuring collectible figures, animated blocks and interactive claw machine gameplay.",
  "authors": [
    "ThePlumTeam"
  ],
  "contact": {
    "homepage": "https://github.com/AkaNebur/BlockPops",
    "sources": "https://github.com/AkaNebur/BlockPops"
  },
  "license": "All Rights Reserved",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.theplumteam.fabric.BlockPopsFabric"
    ],
    "client": [
      "com.theplumteam.fabric.BlockPopsFabricClient"
    ]
  },
  "mixins": [
    "blockpops.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "architectury": ">=9.2.14",
    "geckolib": ">=4.7.4"
  }
